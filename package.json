{
  "name": "the-establish-beauty-site",
  "private": true,
  "version": "0.0.0",
  "description": "EMR-TEK ストア + The Establish Beauty。npm run dev は Node（静的 + /api）。純 Python 表示のみは npm run dev:static。本番相当は npm run dev:vercel。",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "sharp": "^0.34.2",
    "to-ico": "^1.1.5"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vercel-analytics.mjs",
    "vendor:analytics": "node scripts/copy-vercel-analytics.mjs",
    "favicons": "node scripts/generate-favicons.mjs",
    "dev": "node scripts/dev-server.mjs",
    "dev:vercel": "npx vercel dev --listen 5173",
    "dev:static": "python3 -m http.server 5173",
    "dev:5174": "python3 -m http.server 5174",
    "start": "python3 -m http.server 5173"
  }
}
